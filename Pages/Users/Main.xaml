<Page x:Class="Kino_Alikin.Pages.Users.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kino_Alikin.Pages.Users"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Main">

    <Grid>
        <Grid Margin="20" Background="#FFF0F0F0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ComboBox
                x:Name="CmbSort"
                Grid.Row="0"
                Height="25"
                Width="220"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10"
                SelectionChanged="SortUsers">
                <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                <ComboBoxItem Content="По ФИО (А-Я)"/>
                <ComboBoxItem Content="По дате начала аренды"/>
                <ComboBoxItem Content="По длительности"/>
            </ComboBox>
            <ScrollViewer Grid.Row="1" Margin="0,35,0,50">
                <StackPanel x:Name="Parent"/>
            </ScrollViewer>
            <Button
            x:Name="BthAdd"
            Click="AddUser"
            Height="25"
            Content="Добавить"
            VerticalAlignment="Bottom"
            Margin="10"
            HorizontalAlignment="Right"
            Width="100"
            Background="#FF46D000"
            BorderBrush="#FF46D000"
            Foreground="White"/>
        </Grid>
    </Grid>
</Page>
